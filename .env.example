# ============================================================
# Plantilla de configuracion (MPR-001). Copie este archivo como ".env"
# y reemplace los valores. El archivo .env NO se sube a Git y Apache
# bloquea su descarga desde el navegador.
# ============================================================

# Puertos expuestos en el Host (Docker)
APP_PORT=8080
PMA_PORT=8081
DB_PORT=3306

# Conexion que usa el sistema (usuario con permisos minimos, NO root)
DB_HOST=db
DB_NAME=dbfacturacion
DB_USER=facturacion_app
DB_PASSWORD=cambie_esta_clave

# Clave del administrador de MariaDB (solo para Docker y phpMyAdmin)
DB_ROOT_PASSWORD=cambie_esta_clave_root
